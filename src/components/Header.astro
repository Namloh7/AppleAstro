---
import appleLogo from "../assets/images/apple.png"
import searchIcon from "../assets/images/search.png"
import shoppingCartIcon from "../assets/images/shopping-cart.png"
---
<header>
        <nav>
          <img src={appleLogo.src} alt="apple logo" />
          <a class="nav__text" href = "../pages/shop.astro">Obchod</a>
          <a class="nav__text">Mac</a>
          <a class="nav__text">iPad</a>
          <a class="nav__text">iPhone</a>
          <a class="nav__text">Watch</a>
          <a class="nav__text">AirPods</a>
          <a class="nav__text">TV a Domácnost</a>
          <a class="nav__text">Zábava</a>
          <a class="nav__text">Doplňky</a>
          <a class="nav__text">Podpora</a>
          <img src={searchIcon.src} alt="search" class="nav__icon--right" />
          <img
            src={shoppingCartIcon.src}
            alt="shopping cart"
            class="nav__icon--right"
          />
        </nav>
      </header>


      <style>
        body {
            font-family:
            SF Pro Display,
            SF Pro Icons,
            Helvetica Neue,
            Helvetica,
            Arial,
            sans-serif;
            }

        header nav {
            position: fixed;
            overflow: hidden;
            padding-inline-start: max(22px);
            padding-inline-end: max(22px);
            background-color: var(--light-gray-color);
            box-sizing: border-box;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 44px;
            width: 100%;
            padding: 0 20px;
            gap: 20px;
            }

        header img {
            height: 25px;
            }
        .nav__icon--right {
            opacity: 0.6;
            height: 16px;
            }



      </style>